generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  EDITOR
}
enum UserStatus {
  ACTIVE
  DISABLED
}
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum MediaKind {
  IMAGE
  DOCUMENT
}
enum MediaStatus {
  ACTIVE
  TRASHED
}
enum ProductMediaRole {
  GALLERY
  HERO
  SPEC_SHEET
  MANUAL
  CERTIFICATE
}
enum InquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
  SPAM
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  passwordHash String
  role UserRole @default(EDITOR)
  status UserStatus @default(ACTIVE)
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  media MediaAsset[] @relation("UploadedBy")
  auditLogs AuditLog[]
}

model Session {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  ipAddress String?
  countryCode String?
  countryName String?
  regionName String?
  city String?
  userAgent String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id String @id @default(cuid())
  legacyId String? @unique
  handle String @unique
  sku String? @unique
  title String
  summary String?
  description String @db.Text
  legacyCategory String?
  legacyImages Json?
  legacyFeatures Json?
  legacySpecs Json?
  legacyPdfUrl String?
  status ProductStatus @default(DRAFT)
  price Decimal @db.Decimal(10, 2)
  currency String @default("USD")
  stripePaymentLink String?
  whatsappInquiry Boolean @default(false)
  material String?
  dimensions String?
  weight String?
  installation String?
  warranty String?
  seoTitle String?
  seoDescription String? @db.Text
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  specifications ProductSpecification[]
  media ProductMedia[]
  collections ProductCollection[]
  spaces ProductSpace[]
  tags ProductTag[]
  sourceRelations ProductRelation[] @relation("SourceProduct")
  targetRelations ProductRelation[] @relation("TargetProduct")
  inquiries Inquiry[]
  pageViews PageView[]
  @@index([status, publishedAt])
  @@index([updatedAt])
}

model ProductSpecification {
  id String @id @default(cuid())
  productId String
  label String
  value String
  sortOrder Int @default(0)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, sortOrder])
}

model MediaAsset {
  id String @id @default(cuid())
  kind MediaKind
  storageKey String @unique
  publicUrl String
  originalName String
  mimeType String
  byteSize Int
  width Int?
  height Int?
  altText String?
  checksum String?
  status MediaStatus @default(ACTIVE)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User? @relation("UploadedBy", fields: [createdById], references: [id], onDelete: SetNull)
  products ProductMedia[]
  @@index([kind, status, createdAt])
}

model ProductMedia {
  productId String
  mediaId String
  role ProductMediaRole @default(GALLERY)
  sortOrder Int @default(0)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  @@id([productId, mediaId])
  @@index([productId, role, sortOrder])
}

model Collection {
  id String @id @default(cuid())
  handle String @unique
  name String
  nameEn String?
  description String? @db.Text
  coverImage String?
  sortOrder Int @default(0)
  products ProductCollection[]
}

model ProductCollection {
  productId String
  collectionId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  @@id([productId, collectionId])
}

model Space {
  id String @id @default(cuid())
  handle String @unique
  name String
  description String? @db.Text
  sortOrder Int @default(0)
  products ProductSpace[]
}

model ProductSpace {
  productId String
  spaceId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  @@id([productId, spaceId])
}

model Tag {
  id String @id @default(cuid())
  handle String @unique
  name String
  products ProductTag[]
}

model ProductTag {
  productId String
  tagId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([productId, tagId])
}

model ProductRelation {
  sourceProductId String
  targetProductId String
  relationType String
  sortOrder Int @default(0)
  sourceProduct Product @relation("SourceProduct", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProduct Product @relation("TargetProduct", fields: [targetProductId], references: [id], onDelete: Cascade)
  @@id([sourceProductId, targetProductId, relationType])
}

model Inquiry {
  id String @id @default(cuid())
  name String
  email String
  phone String?
  message String @db.Text
  productId String?
  source String @default("contact-form")
  visitorId String?
  ipAddress String?
  countryCode String?
  countryName String?
  regionName String?
  city String?
  userAgent String?
  status InquiryStatus @default(NEW)
  internalNotes String? @db.Text
  assignedToId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
  @@index([ipAddress, createdAt])
  @@index([countryCode, regionName, city])
  @@index([visitorId, createdAt])
}

model PageView {
  id String @id @default(cuid())
  visitorId String
  sessionId String?
  path String
  productId String?
  pageTitle String?
  queryString String?
  ipAddress String?
  countryCode String?
  countryName String?
  regionName String?
  city String?
  userAgent String?
  referrer String?
  utmSource String?
  utmMedium String?
  utmCampaign String?
  language String?
  timezone String?
  screenWidth Int?
  screenHeight Int?
  durationMs Int?
  createdAt DateTime @default(now())
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([productId, createdAt])
  @@index([visitorId, createdAt])
  @@index([sessionId, createdAt])
  @@index([path, createdAt])
  @@index([ipAddress, createdAt])
  @@index([countryCode, regionName, city])
}

model SiteSetting {
  key String @id
  value Json
  updatedById String?
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  entityType String
  entityId String?
  before Json?
  after Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
}

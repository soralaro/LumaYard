NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL
# DATABASE_URL=postgresql://lumayard_app:replace-with-a-strong-password@127.0.0.1:5434/lumayard?schema=public

# Admin Panel
# Create the initial Owner with: npm run admin:create -- owner@example.com 'a-password-with-at-least-12-characters'
# Never expose an administrator password with a NEXT_PUBLIC_ variable.

WHATSAPP_NUMBER=15551234567

# Resend (email)
RESEND_API_KEY=re_your_api_key_here
CONTACT_FROM_EMAIL=LumaYard <hello@lumayard.com>
CONTACT_TO_EMAIL=team@lumayard.com

# Stripe Payment Links (replace with real links)
# STRIPE_FENCE_PANEL_LINK=https://buy.stripe.com/...
# STRIPE_SOLAR_LIGHT_LINK=https://buy.stripe.com/...

# Claude API (for future AI Planner Phase 3)
# CLAUDE_API_KEY=sk-ant-...

# Cloudflare R2 / S3-compatible media storage
# The Access Key and Secret are server-only. Never prefix them with NEXT_PUBLIC_.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=lumayard
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# Optional: a custom public R2 domain. If omitted, the app serves media securely at /media/<key>.
# S3_PUBLIC_URL=https://media.example.com

# Analytics (optional)
# UMAMI_WEBSITE_ID=...
# NEXT_PUBLIC_GA_ID=G-...

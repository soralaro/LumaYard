# Public site URL used by metadata, sitemap, and canonical links.
NEXT_PUBLIC_SITE_URL=https://lumayard.com

# Contact delivery (Resend is optional in local development).
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_FROM_EMAIL=LumaYard <hello@lumayard.com>
CONTACT_TO_EMAIL=hello@lumayard.com

# WhatsApp number in international format, digits only.
WHATSAPP_NUMBER=15551234567

# Admin access. Use a long random password and a separate random session secret.
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-a-different-random-secret

# Replace the placeholder Stripe Payment Links in data/products.ts.

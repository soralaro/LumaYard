# Public site URL used by metadata, sitemap, and canonical links.
NEXT_PUBLIC_SITE_URL=https://lumayard.com

# Contact delivery (Resend is optional in local development).
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_FROM_EMAIL=LumaYard <hello@lumayard.com>
CONTACT_TO_EMAIL=hello@lumayard.com

# WhatsApp number in international format, digits only.
WHATSAPP_NUMBER=15551234567

# Local development only: save uploads under public/uploads instead of R2.
NEXT_PUBLIC_LOCAL_UPLOADS=true

# Admin access. Use a long random password and a separate random session secret.
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-a-different-random-secret

# PostgreSQL for the production admin system.
DATABASE_URL=postgresql://lumayard:lumayard_dev@127.0.0.1:5432/lumayard?schema=public

# Cloudflare R2 / S3-compatible media storage.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=lumayard-media
S3_ACCESS_KEY_ID=replace-with-r2-access-key
S3_SECRET_ACCESS_KEY=replace-with-r2-secret-key
S3_PUBLIC_URL=https://media.lumayard.com

# Replace the placeholder Stripe Payment Links in data/products.ts.
